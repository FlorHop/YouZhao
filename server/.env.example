# YouZhao 服务端环境变量示例（与 docs/architecture-design.md §3.9 一一对应）
# 用法：复制为 .env 并改成自己的值（下列 = 右侧是可通过校验的本地开发默认值，
# 形如 local-dev-* 的字符串仅供本机开发，生产必须换成随机值）。
# 缺少必填项时进程会在启动阶段一次性列出全部问题并以 exit 1 结束（server/config.ts）。

# ── 应用 ─────────────────────────────────────────────────────────────
APP_NAME=youzhao
APP_ENV=development                  # development | production
APP_HOST=http://127.0.0.1:5173
APP_TIMEZONE=Asia/Shanghai

# ── HTTP 服务 ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_BASE_URL=http://127.0.0.1:3000
API_JSON_BODY_LIMIT_BYTES=5242880

# ── 会话与跨站防护 ───────────────────────────────────────────────────
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_NAME=yz_session
CSRF_ORIGIN_ALLOWLIST=http://127.0.0.1:5173
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_MCP_PER_MINUTE=120        # MCP 调用限流，按 Token 维度（§4.5）

# ── 数据库 ───────────────────────────────────────────────────────────
# 生产只能是 postgres；本机没有 Postgres 时改成 pglite，api 用内存库启动
# （重启即清空，生产会被 config.ts 拒绝）。此时下面的 POSTGRES_* 可以不填。
DB_DRIVER=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=youzhao
POSTGRES_USER=youzhao
POSTGRES_PASSWORD=local-dev-password

# ── 初始所有者（仅首次启动、用户表为空时生效）────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-dev-owner-password
ADMIN_DISPLAY_NAME=系统管理员

# ── 预览域 ───────────────────────────────────────────────────────────
PREVIEW_PUBLIC_BASE_PATH=/preview
PREVIEW_STORAGE_PATH=/data/youzhao/previews
PREVIEW_TICKET_SECRET=local-dev-ticket-secret-0123456789   # 必填，无回退值；生产用随机值
PREVIEW_EMBED_SECRET=local-dev-embed-secret-0123456789    # 生产必填且 ≥32；留空=未启用嵌入，返回 503
PREVIEW_TICKET_TTL_SECONDS=60
PREVIEW_DOMAIN=http://127.0.0.1:3001  # 预览域；必须与应用域不同源（校验强制）

# ── MCP ──────────────────────────────────────────────────────────────
MCP_ENABLED=true
MCP_MAX_BODY_BYTES=5242880
MCP_PATH=/mcp                         # 挂载路径；网关把该前缀转发到 api
