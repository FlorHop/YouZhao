{
  "name": "youzhao-demo-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:gen": "pnpm -C packages/contracts gen",
    "contracts:check": "pnpm -C packages/contracts check",
    "contracts:test": "pnpm -C packages/contracts test",
    "server:dev": "pnpm -C server dev",
    "server:start": "pnpm -C server start",
    "server:migrate": "pnpm -C server migrate",
    "server:migrate:legacy": "pnpm -C server migrate:legacy",
    "server:lint": "pnpm -C server lint",
    "server:typecheck": "pnpm -C server typecheck",
    "server:test": "pnpm -C server test",
    "web:dev": "pnpm -C web dev",
    "web:preview-origin": "pnpm -C web dev:preview-origin",
    "web:build": "pnpm -C web build",
    "web:typecheck": "pnpm -C web typecheck",
    "web:lint": "pnpm -C web lint",
    "web:test": "pnpm -C web test",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "verify": "pnpm contracts:check && pnpm contracts:test && pnpm server:lint && pnpm server:typecheck && pnpm server:test && pnpm web:lint && pnpm web:typecheck && pnpm web:test"
  },
  "pnpm": {
    "verifyDepsBeforeRun": false
  }
}
