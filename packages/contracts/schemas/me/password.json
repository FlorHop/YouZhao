{
  "$id": "me/password",
  "title": "ChangeOwnPasswordRequest",
  "description": "POST /api/me/password 请求体（docs/permission-design.md §6.2 本人自助）：本人修改密码，需校验原密码",
  "type": "object",
  "properties": {
    "oldPassword": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "当前密码"
    },
    "newPassword": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "description": "新密码（至少 8 位）"
    }
  },
  "required": [
    "oldPassword",
    "newPassword"
  ],
  "additionalProperties": false
}
