{
  "$id": "tokens/mutation",
  "title": "McpTokenMutationResponse",
  "description": "MCP Token 写操作（改名 / 启停 / 删除）的统一响应：返回被改动 Token 的当前状态",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/McpTokenSummary"
    },
    "meta": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "请求 id"
        }
      },
      "required": ["requestId"],
      "additionalProperties": false
    }
  },
  "required": ["data", "meta"],
  "additionalProperties": false,
  "$defs": {
    "McpTokenSummary": {
      "type": "object",
      "description": "MCP Token 摘要；明文令牌永不在此出现",
      "properties": {
        "id": {
          "type": "string",
          "description": "不透明 Token id，如 tok_xxx"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Token 名称"
        },
        "tokenPrefix": {
          "type": "string",
          "description": "明文令牌前缀，仅用于辨认，不可用于鉴权"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["read:blueprint", "publish:blueprint"]
          },
          "description": "授权范围；Token 能力 = 绑定用户能力 ∩ scope"
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"],
          "description": "Token 状态；disabled 后该 Token 立即不可用"
        },
        "boundUserId": {
          "type": "string",
          "description": "绑定用户 id：Token 以该用户的身份与权限调用"
        },
        "boundUserDisplayName": {
          "type": "string",
          "description": "绑定用户姓名"
        },
        "createdByUserId": {
          "type": "string",
          "description": "创建者用户 id"
        },
        "createdByDisplayName": {
          "type": "string",
          "description": "创建者姓名"
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "过期时间（ISO 8601）；null = 永不过期"
        },
        "lastUsedAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "最近一次使用时间（ISO 8601）；null = 从未使用"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间（ISO 8601）"
        }
      },
      "required": [
        "id",
        "name",
        "tokenPrefix",
        "scopes",
        "status",
        "boundUserId",
        "boundUserDisplayName",
        "createdByUserId",
        "createdByDisplayName",
        "expiresAt",
        "lastUsedAt",
        "createdAt"
      ],
      "additionalProperties": false
    }
  }
}
