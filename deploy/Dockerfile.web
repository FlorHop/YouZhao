# 有招 web 镜像：构建 SPA 静态产物，用 nginx 提供（只服务静态资源，不做反向代理）
FROM node:24-alpine AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
WORKDIR /app
# 可选：内网/镜像站加速（留空则用默认 npm 源）。由 compose 的 NPM_REGISTRY 传入。
ARG NPM_REGISTRY=
RUN if [ -n "$NPM_REGISTRY" ]; then printf 'registry=%s\n' "$NPM_REGISTRY" > /root/.npmrc; fi
COPY package.json ./
COPY packages/contracts/package.json packages/contracts/
COPY server/package.json server/
COPY web/package.json web/
COPY web/pnpm-workspace.yaml web/
RUN pnpm -C packages/contracts install --no-frozen-lockfile \
 && pnpm -C web install --no-frozen-lockfile
COPY packages/contracts packages/contracts
COPY web web
RUN node packages/contracts/scripts/generate.mjs && pnpm -C web build

FROM nginx:1.27-alpine AS runtime
COPY deploy/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
# 构建阶段的产物继承 root + 开发机 umask（可能 0600），nginx worker 需要可读
RUN chmod -R a+rX /usr/share/nginx/html
EXPOSE 80
