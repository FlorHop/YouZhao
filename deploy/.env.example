# =============================================================================
# 有招 · 单机生产版部署环境变量（复制为 deploy/.env 使用）
#   cp deploy/.env.example deploy/.env && $EDITOR deploy/.env
#   或直接跑 deploy/scripts/install.sh（会自动生成 .env 并把密钥换成随机值）
#
# 覆盖范围：docs/architecture-design.md §3.9 的全部应用变量 + docs/deployment-rules.md
# 要求的部署变量。逐项与 server/.env.example 对齐（同名同义），差异只在「生产值 vs 本地值」。
#
# ⚠ 必须替换：所有 `please-change-this-*` 都是占位符，不是可用的密钥。
#   server/config.ts 的 FORBIDDEN_SECRETS（change_me / changeme / secret / 123456 /
#   youzhao_embed_dev_secret）会全环境拒绝；APP_ENV=production 时密钥长度还必须 ≥32。
#   生成随机值：openssl rand -hex 32
#
# ⚠ 生产硬性约束（server/config.ts 启动即校验，不满足直接 exit 1）：
#   APP_ENV=production、DB_DRIVER=postgres、API_PUBLIC_BASE_URL 与 PREVIEW_DOMAIN 必须 https，
#   且 PREVIEW_DOMAIN 与应用域**不同源**（同源会让产物脚本拿到会话能力，§7 安全设计）。
# =============================================================================

# ── 部署编排（仅 deploy/scripts 与 compose 使用）──────────────────────────────
COMPOSE_PROJECT_NAME=youzhao
IMAGE_TAG=latest
# 可选：内网/镜像站加速（留空用默认 npm 源，例如 https://registry.npmmirror.com）
NPM_REGISTRY=
DATA_ROOT=/data/youzhao
# 宿主机数据根目录。会创建/使用：
#   ${DATA_ROOT}/postgres  → postgres 数据（compose 命名卷 youzhao-postgres-data 的挂载点）
#   ${DATA_ROOT}/previews  → 预览产物卷（挂到 api 容器 /data/youzhao/previews）
#   ${DATA_ROOT}/backups   → backup.sh 的归档目录
#   ${DATA_ROOT}/logs      → 运维脚本日志（restore.sh）
#   ${DATA_ROOT}/uploads   → 预留（大文件/导入中转）
TZ=Asia/Shanghai
INSTALL_HEALTH_TIMEOUT=300
UPGRADE_HEALTH_TIMEOUT=300
# 上面两条只给 install.sh/upgrade.sh 用（等健康检查的秒数），不参与应用语义。
BACKUP_KEEP=7
# backup.sh 归档保留份数（upgrade.sh / restore.sh 的安全备份也用它）；0 = 不清理。

# ── 网关（gateway 容器：唯一入口）─────────────────────────────────────────────
GATEWAY_HTTP_PORT=80
GATEWAY_PREVIEW_HTTP_PORT=8080
GATEWAY_APP_HOST=youzhao.example.com
GATEWAY_PREVIEW_HOST=preview.youzhao.example.com
GATEWAY_TLS_CERT_DIR=./certs
# 域名只写主机名（不含 scheme/端口）：nginx `server_name` 用它与 Host 匹配，
# 应用域与预览域可以是同一台机器的两个端口（本地验收），也可以是两个真实域名（生产）。
# 生产要保证：GATEWAY_APP_HOST == API_PUBLIC_BASE_URL 的主机名；
#             GATEWAY_PREVIEW_HOST == PREVIEW_DOMAIN 的主机名。
# TLS 默认关闭（本地验收无证书）；要启用见 deploy/gateway/nginx.conf 文末注释，
# 证书放 GATEWAY_TLS_CERT_DIR（certs/fullchain.pem + certs/privkey.pem）。

# ── 应用（§3.9）──────────────────────────────────────────────────────────────
APP_NAME=youzhao
APP_ENV=production
APP_HOST=https://youzhao.example.com
APP_TIMEZONE=Asia/Shanghai
# 注：server 端当前只读 API_PUBLIC_BASE_URL 判应用源，APP_HOST 未被 config.ts 读取
#（§3.9 列了它，本文件按文档保留）；换域名时请与 API_PUBLIC_BASE_URL / GATEWAY_APP_HOST 一起改。

# ── HTTP 服务（§3.9）─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_BASE_URL=https://youzhao.example.com
API_JSON_BODY_LIMIT_BYTES=5242880
# 上面这个值同时是网关 client_max_body_size 的来源（§4.7）；调大它要同时确认
# MCP_MAX_BODY_BYTES 不超过它，否则大请求会先被网关 413。

# ── 会话与跨站防护（§3.9）────────────────────────────────────────────────────
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_NAME=yz_session
CSRF_ORIGIN_ALLOWLIST=https://youzhao.example.com
# 逗号分隔。必须包含应用域，否则：写请求被 CSRF 拦（403），
# 且预览产物的 CSP frame-ancestors 不含它 → 应用里的预览 iframe 打不开（§4.6/§7）。
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_MCP_PER_MINUTE=120

# ── 数据库（§3.9）────────────────────────────────────────────────────────────
DB_DRIVER=postgres
POSTGRES_HOST=postgres
# 生产固定为 compose 服务名（容器 DNS）；即使误填 127.0.0.1，compose 也会覆盖成 postgres。
POSTGRES_PORT=5432
POSTGRES_DB=youzhao
POSTGRES_USER=youzhao
POSTGRES_PASSWORD=please-change-this-postgres-password-0001

# ── 初始所有者（§3.9；仅首次启动、用户表为空时生效）─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-admin-password-0001
ADMIN_DISPLAY_NAME=系统管理员
# 首次登录后请在「修改密码」里换掉；该明文也会留在 .env（chmod 600）里，注意备份安全。

# ── 预览域（§3.9 / §4.6）─────────────────────────────────────────────────────
PREVIEW_PUBLIC_BASE_PATH=/preview
PREVIEW_STORAGE_PATH=/data/youzhao/previews
PREVIEW_TICKET_SECRET=please-change-this-preview-ticket-secret-0001
PREVIEW_EMBED_SECRET=please-change-this-preview-embed-secret-0001
PREVIEW_TICKET_TTL_SECONDS=60
PREVIEW_DOMAIN=https://preview.youzhao.example.com
# PREVIEW_STORAGE_PATH 是**容器内**路径，与 compose 的预览卷挂载点保持一致（不要改成宿主路径）。
# PREVIEW_DOMAIN 是与应用域不同的源：生产用真实子域，本地验收用 http://127.0.0.1:8080（见文末）。

# ── MCP（§3.9 / §4.7）────────────────────────────────────────────────────────
MCP_ENABLED=true
MCP_MAX_BODY_BYTES=5242880
MCP_PATH=/mcp
# 网关按 MCP_PATH 转发（deploy/gateway/nginx.conf 里是字面量 /mcp）；
# 改这里必须同步改网关配置，否则客户端连不上。

# =============================================================================
# 本机无证书验收（可选）：全部取消注释后覆盖上面同名项 —— 用 80/8080 两个端口区分
# 应用域与预览域，两者仍然是不同的源（端口不同），config.ts 的校验能通过。
#   APP_ENV=development
#   APP_HOST=http://127.0.0.1
#   API_PUBLIC_BASE_URL=http://127.0.0.1
#   CSRF_ORIGIN_ALLOWLIST=http://127.0.0.1
#   PREVIEW_DOMAIN=http://127.0.0.1:8080
#   GATEWAY_APP_HOST=127.0.0.1
#   GATEWAY_PREVIEW_HOST=127.0.0.1
# =============================================================================
